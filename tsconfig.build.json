{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "allowArbitraryExtensions": true,
    "skipLibCheck": true
  },
  "include": [
    "index.ts",
    "client/**/*.ts",
    "tailwind/**/*.ts",
    "types/**/*.d.ts"
  ],
  "exclude": ["dist", "docs", "preview"]
}
