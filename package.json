{
  "name": "@hitszosa/ui",
  "version": "0.1.0",
  "description": "Astro-first shared UI assets, theme tokens, and components for HITSZ OSA sites.",
  "packageManager": "bun@1.3.10",
  "type": "module",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hitszosa/ui.git"
  },
  "keywords": [
    "astro",
    "tailwindcss",
    "hitszosa",
    "osa"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "lint": "eslint index.ts client components tailwind scripts types eslint.config.mjs",
    "lint:fix": "eslint index.ts client components tailwind scripts types eslint.config.mjs --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "node ./scripts/prepare.mjs",
    "prepack": "node ./scripts/build.mjs"
  },
  "lint-staged": {
    "*.{astro,css,js,json,md,mjs,ts}": [
      "prettier --write"
    ],
    "*.{astro,js,mjs,ts}": [
      "eslint --fix"
    ]
  },
  "exports": {
    "./tailwind/preset": "./dist/tailwind/preset.js",
    "./tailwind/preset.ts": "./dist/tailwind/preset.js",
    "./styles/theme.css": "./dist/styles/theme.css",
    "./client/theme": "./dist/client/theme.js",
    "./client/theme-init": "./dist/client/theme-init.js",
    "./components/*": "./dist/components/*",
    "./assets/*": "./dist/assets/*",
    ".": "./dist/index.js"
  },
  "files": [
    "dist/"
  ],
  "dependencies": {
    "iconify-icon": "^3.0.2"
  },
  "peerDependencies": {
    "astro": ">=6.0.0",
    "tailwindcss": ">=4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "astro": "^6.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-astro": "^1.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.9.3"
  }
}
